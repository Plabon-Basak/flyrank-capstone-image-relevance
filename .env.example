APP_NAME=Image Relevance and Auto-Tagging
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/image_matching

METADATA_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3.8-flash

EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

API_BUDGET_USD=5.0
GEMINI_VISION_INPUT_COST_PER_MILLION_TOKENS=0.75
GEMINI_VISION_OUTPUT_COST_PER_MILLION_TOKENS=3.75
GEMINI_EMBEDDING_COST_PER_MILLION_CHARACTERS=0.00015
